# ─── Genre ─────────────────────────────────────────────────────────────────

man1k:genre_witchhouse
    a mo:Genre ;
    rdfs:label         "Witch House" ;
    schema:description "Electronic music genre combining lo-fi hip-hop beats, shoegaze textures, chopped/screwed vocals, and occult aesthetics. Emerged circa 2009–2011." ;
    schema:sameAs      <https://www.wikidata.org/wiki/Q1247719> .

# ─── Collective ────────────────────────────────────────────────────────────

man1k:group_deadray
    a schema:MusicGroup ;
    schema:name        "DeadRay" ;
    schema:description "Unholy duo with vocalist Lakomi" .

man1k:role_deadray
    a schema:Role ;
    schema:roleName    "Producer" ;
    schema:memberOf    man1k:group_deadray .

